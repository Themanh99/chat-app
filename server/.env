# Server
PORT=4000
NODE_ENV=development

# Rate Limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# JWT
JWT_SECRET="chat_jwt_secret_key"
JWT_KEY="chat_jwt_key"
JWT_REFRESH_KEY="chat_jwt_refresh_key"
ACCESS_TOKEN_AGE=900000 
REFRESH_TOKEN_AGE=604800000

# CORS
ORIGIN="http://localhost:5173"

# MongoDB
DB_HOST=127.0.0.1
DB_PORT=27017
DB_NAME=mongo-chat-app
DB_USER=
DB_PASS=
DB_AUTH_DB=admin
